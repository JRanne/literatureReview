# AI backend
#   auto        (default) use ANTHROPIC_API_KEY if set, otherwise the logged-in `claude` CLI
#   claude-cli  always use the claude CLI in headless mode (your Claude subscription, no API key)
#   api         always use the Anthropic API with ANTHROPIC_API_KEY
AI_BACKEND=auto
ANTHROPIC_API_KEY=                     # leave empty to use your subscription via the claude CLI
ANTHROPIC_MODEL=claude-sonnet-5-5      # model for the API backend
CLAUDE_CLI=claude                      # path to the claude binary
CLAUDE_CLI_MODEL=                      # e.g. sonnet / opus; empty = your account's default model

# Required
CONTACT_EMAIL=you@university.fi        # sent to OpenAlex / CrossRef / Unpaywall (polite pools; Unpaywall requires it)

# Second screener (optional): TypeSafe Jev gives an independent calibrated score per paper.
# Decisions are pre-filled only when Claude and Jev agree; conflicts are left for you.
#JEV_API_KEY=apikey_...                # from https://console.typesafe.ai/settings/keys
#JEV_MODEL=jev-latest
#SCREENER=both                         # both (default with a Jev key) | claude | jev

# Optional
S2_API_KEY=                            # Semantic Scholar key: lifts the shared anonymous rate limit (strongly recommended)
OPENALEX_API_KEY=                      # OpenAlex key: lifts the free tier's daily credit budget (recommended for heavy use)
CORE_API_KEY=                          # enables the CORE database (https://core.ac.uk/services/api)

# University access: prefer the in-app Library access page (browser login);
# these are only fallbacks and the page's settings override them.
#PROXY_PREFIX=https://ezproxy.utu.fi/login?url=
#PROXY_COOKIE=ezproxy=PASTE_SESSION_VALUE_HERE
#BROWSER_BIN=chromium                  # Chromium-based browser for login + headless downloads
#BROWSER_FETCH=auto                    # auto | off

# Server
ADDR=:8080
DATA_DIR=data
