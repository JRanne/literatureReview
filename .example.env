# litreview settings. Copy this file to .env and fill in what you need:
#
#   cp .example.env .env
#
# Format: KEY=value, one per line. No spaces around "=", no quotes needed.
# A "#" after a space starts a comment. Leave a value empty to use the default.
# Variables already set in your shell override this file.
# .env is gitignored: never commit it, it holds your keys.
# README.md, section "Setting up .env", explains every value.

# --- 1. Required -------------------------------------------------------------

# Your e-mail address. Unpaywall refuses requests without one; OpenAlex,
# CrossRef and PubMed answer faster when you send it.
CONTACT_EMAIL=

# --- 2. Claude ----------------------------------------------------------------
# Nothing to set if the claude CLI is installed and you ran `claude /login`:
# the app then uses your Claude subscription.
#
#   auto        use ANTHROPIC_API_KEY if set, otherwise the claude CLI (default)
#   claude-cli  always the CLI (subscription)
#   api         always the API key
AI_BACKEND=auto
ANTHROPIC_API_KEY=                     # only for API billing: Claude Console → Settings → API keys
ANTHROPIC_MODEL=claude-sonnet-5-5      # base model for the API backend
CLAUDE_CLI=claude                      # path to the claude binary
CLAUDE_CLI_MODEL=                      # base model for the CLI backend; empty = sonnet

# --- 3. Model per review step (optional) --------------------------------------
# Empty = the base model above. haiku / sonnet / opus / fable always mean the
# newest model of that family; an exact id (claude-opus-5-5) stays pinned.
# Each project can also override these under Setup → Language models.
# Adjudication and concepts fall back to MODEL_SYNTHESIS.
MODEL_QUERIES=
MODEL_SCREENING=                       # e.g. haiku: most calls happen here
MODEL_ADJUDICATION=
MODEL_EXTRACTION=
MODEL_CONCEPTS=
MODEL_SYNTHESIS=                       # e.g. opus for the background section

# --- 4. Database keys (free, recommended) -------------------------------------
# Searching works without these, but the anonymous limits are low.
S2_API_KEY=                            # Semantic Scholar: https://www.semanticscholar.org/product/api
OPENALEX_API_KEY=                      # OpenAlex: free account → https://openalex.org/settings/api
CORE_API_KEY=                          # CORE: https://core.ac.uk/services/api (CORE is offered only with a key)

# --- 5. Second screener (optional) --------------------------------------------
# TypeSafe Jev scores every paper independently of Claude.
JEV_API_KEY=                           # https://console.typesafe.ai/settings/keys
JEV_MODEL=jev-latest
SCREENER=                              # both | claude | jev; empty = both with a Jev key, else claude

# --- 6. University library (optional) -----------------------------------------
# Prefer the in-app Library access page (browser login); it overrides these.
PROXY_PREFIX=                          # e.g. https://ezproxy.utu.fi/login?url=
PROXY_COOKIE=                          # e.g. ezproxy=SESSION_VALUE
BROWSER_BIN=                           # empty = first of chromium, google-chrome, brave
BROWSER_FETCH=auto                     # auto | off (headless-browser PDF download)

# --- 7. Server ----------------------------------------------------------------
ADDR=:8080
DATA_DIR=data
